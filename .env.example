# QJudge minimal deployment environment.
#
# Do not edit generated secrets by hand. Export the four object-storage values,
# then run scripts/setup-env.sh to create the active, git-ignored .env file.

# Public origin opened by users. setup-env.sh normalizes the value.
QJUDGE_PUBLIC_ORIGIN=

# Generated by scripts/setup-env.sh.
SECRET_KEY=
POSTGRES_ADMIN_PASSWORD=
DB_PASSWORD=
AI_DB_PASSWORD=
CREDENTIAL_LEASE_SECRET=

# External S3-compatible object storage. The initializer supports R2 and MinIO.
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# setup-env.sh also writes the provider-specific region, bucket-creation and
# object-tagging policy. Deployers do not need to manage those values manually.

# Optional AI providers. Uncomment only the provider in use.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional public Remote MCP and Cloudflare Tunnel.
# MCP_PUBLIC_URL=
# TUNNEL_TOKEN=

# Optional third-party login providers.
# Endpoints, scopes and credential variable names ship in
# backend/config/qauth-providers.json, which already covers NYCU, GitHub and
# Google. Filling in a pair of credentials below is all it takes to enable that
# provider; a provider whose credentials are missing stays hidden from the login
# page instead of failing at sign-in time.
# NYCU_OAUTH_CLIENT_ID=
# NYCU_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Override the shipped provider catalog only when a deployment federates with a
# different identity provider. A JSON array here replaces the file entirely, and
# an explicit empty array disables every OAuth provider. Point
# QAUTH_PROVIDER_CONNECTIONS_FILE at another path to load the catalog from disk.
# QAUTH_PROVIDER_CONNECTIONS_JSON=
# QAUTH_PROVIDER_CONNECTIONS_FILE=

# Optional SMTP credentials.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Optional self-hosted LiveKit monitoring. Keep disabled until the local
# LiveKit/TURN endpoint has been validated with the deployment runbook.
LIVE_MONITORING_ENABLED=false
# LIVE_MONITORING_PROVIDER=livekit
# LIVEKIT_ENVIRONMENT=main
# LIVEKIT_PUBLIC_URL=wss://livekit.example.com
# LIVEKIT_INTERNAL_URL=http://livekit:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_NODE_IP=
# LIVEKIT_STUN_HOST=turn:3478
# LIVEKIT_IMAGE=livekit/livekit-server:v1.13.7@sha256:6fd3b7088874c4d119160dd688798dfec852bc014786d392caad15f6f63912a3
# LIVEKIT_CONFIG_FILE=./.tmp/livekit/main.json
