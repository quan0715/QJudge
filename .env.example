# QJudge minimal deployment environment.
#
# Do not edit generated secrets by hand. Export the four object-storage values,
# then run scripts/setup-env.sh to create the active, git-ignored .env file.

# Public origin opened by users. setup-env.sh normalizes the value.
QJUDGE_PUBLIC_ORIGIN=

# Generated by scripts/setup-env.sh.
SECRET_KEY=
POSTGRES_ADMIN_PASSWORD=
DB_PASSWORD=
AI_DB_PASSWORD=
CREDENTIAL_LEASE_SECRET=

# External S3-compatible object storage. The current initializer supports R2.
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Optional AI providers. Uncomment only the provider in use.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=

# Optional public Remote MCP and Cloudflare Tunnel.
# MCP_PUBLIC_URL=
# TUNNEL_TOKEN=

# Optional third-party login providers.
# NYCU_OAUTH_CLIENT_ID=
# NYCU_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Optional SMTP credentials.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Optional Cloudflare Realtime credentials.
# CLOUDFLARE_REALTIME_APP_ID=
# CLOUDFLARE_REALTIME_APP_SECRET=
