# QJudge deployment settings.
# Generated by `deploy/qjudge env-example`; edit deploy/qjudge_cli/schema.py instead.
# Copy to deploy/.env, fill in values, then run `deploy/qjudge check`.
# Commented keys are optional or required only for the feature they belong to.

# --- Core ---
# Origin users open in the browser, e.g. https://judge.example.edu (no path).
QJUDGE_PUBLIC_ORIGIN=
# Address the frontend (the single HTTP entry point) listens on. Use the VPS private IP when the reverse proxy is on another machine.
# FRONTEND_BIND_ADDRESS=
# Port the frontend listens on.
# FRONTEND_PORT=
# Comma-separated IPs or CIDRs of the reverse proxy; required when the frontend is not bound to 127.0.0.1.
# QJUDGE_TRUSTED_PROXIES=
# Compose project name; keep it unchanged on existing hosts.
# COMPOSE_PROJECT_NAME=
# Optional Compose profiles, e.g. tunnel.
# COMPOSE_PROFILES=
# Django secret key. Generated by `qjudge init`.
SECRET_KEY=
# PostgreSQL administrator password (letters, digits and -._~). Generated by `qjudge init`.
POSTGRES_ADMIN_PASSWORD=
# Application database password (letters, digits and -._~). Generated by `qjudge init`.
DB_PASSWORD=
# AI database password (letters, digits and -._~). Generated by `qjudge init`.
AI_DB_PASSWORD=
# AI credential lease secret. Generated by `qjudge init`.
CREDENTIAL_LEASE_SECRET=
# Absolute path of the QJudge checkout on the Docker host; used to locate judge seccomp profiles.
# HOST_PROJECT_ROOT=

# --- Object storage ---
# bundled runs MinIO via `deploy/qjudge addon storage up`; external uses an existing S3-compatible service.
STORAGE_MODE=
# Browser storage URL. Bundled defaults to QJUDGE_PUBLIC_ORIGIN (no extra domain); external requires an HTTPS URL when the origin is HTTPS.
# OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=
# Storage URL reachable from containers; http://minio:9000 in bundled mode.
OBJECT_STORAGE_ENDPOINT_URL=
# Storage access key; also the MinIO root user in bundled mode.
OBJECT_STORAGE_ACCESS_KEY=
# Storage secret key; also the MinIO root password (at least 8 characters) in bundled mode.
OBJECT_STORAGE_SECRET_KEY=
# Bucket holding every QJudge object.
OBJECT_STORAGE_BUCKET=
# Host directory for bundled MinIO data; a Docker volume is used when unset.
# MINIO_DATA_DIR=

# --- Live monitoring (LiveKit) ---
# disabled, bundled (LiveKit addon; run qjudge addon media init then qjudge addon media up) or external (existing LiveKit).
# MEDIA_MODE=
# Browser LiveKit URL. Bundled defaults to QJUDGE_PUBLIC_ORIGIN + /livekit (ws/wss); required for external mode.
# LIVEKIT_PUBLIC_URL=
# LiveKit API key.
# LIVEKIT_API_KEY=
# LiveKit API secret.
# LIVEKIT_API_SECRET=
# Public IP LiveKit advertises for media (bundled mode).
# LIVEKIT_NODE_IP=
# DNS-only TURN hostname; the host proxy terminates its TLS on 443 (bundled mode).
# LIVEKIT_TURN_HOST=

# --- AI providers ---

# --- Third-party login ---
# NYCU OAuth client ID.
# NYCU_OAUTH_CLIENT_ID=
# NYCU OAuth client secret.
# NYCU_OAUTH_CLIENT_SECRET=
# GitHub OAuth client ID.
# GITHUB_OAUTH_CLIENT_ID=
# GitHub OAuth client secret.
# GITHUB_OAUTH_CLIENT_SECRET=
# Google OAuth client ID.
# GOOGLE_OAUTH_CLIENT_ID=
# Google OAuth client secret.
# GOOGLE_OAUTH_CLIENT_SECRET=
# false disables email/password login (use third-party login only).
# AUTH_EMAIL_PASSWORD_ENABLED=
# JSON array replacing the shipped OAuth provider catalog; [] disables all providers.
# QAUTH_PROVIDER_CONNECTIONS_JSON=

# --- Email ---
# SMTP host.
# EMAIL_HOST=
# SMTP port.
# EMAIL_PORT=
# Sender address for outgoing email.
# DEFAULT_FROM_EMAIL=
# SMTP username.
# EMAIL_HOST_USER=
# SMTP password.
# EMAIL_HOST_PASSWORD=

# --- Cloudflare Tunnel ---
# Cloudflare Tunnel token; required when COMPOSE_PROFILES includes tunnel.
# TUNNEL_TOKEN=

# --- Local development only ---
# Judge container platform, e.g. linux/amd64 on Apple Silicon.
# DOCKER_JUDGE_PLATFORM=
