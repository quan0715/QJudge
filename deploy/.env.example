# QJudge deployment settings.
# Generated by `deploy/qjudge env-example`; edit deploy/qjudge_cli/schema.py instead.
# Copy to deploy/.env, fill in values, then run `deploy/qjudge check`.
# Commented keys are optional or required only for the feature they belong to.

# --- Core ---
# Origin users open in the browser, e.g. https://judge.example.edu (no path).
QJUDGE_PUBLIC_ORIGIN=
# Address the gateway listens on. Use the VPS private IP when the reverse proxy is on another machine.
# GATEWAY_BIND_ADDRESS=
# Port the gateway listens on.
# GATEWAY_PORT=
# Comma-separated IPs of the reverse proxy in front of the gateway.
# QJUDGE_TRUSTED_PROXIES=
# Compose project name; keep it unchanged on existing hosts.
# COMPOSE_PROJECT_NAME=
# Optional Compose profiles, e.g. tunnel.
# COMPOSE_PROFILES=
# Django secret key. Generated by `qjudge init`.
SECRET_KEY=
# PostgreSQL administrator password (letters and digits). Generated by `qjudge init`.
POSTGRES_ADMIN_PASSWORD=
# Application database password (letters and digits). Generated by `qjudge init`.
DB_PASSWORD=
# AI database password (letters and digits). Generated by `qjudge init`.
AI_DB_PASSWORD=
# AI credential lease secret. Generated by `qjudge init`.
CREDENTIAL_LEASE_SECRET=

# --- Object storage ---
# bundled runs MinIO as a QJudge addon; external uses an existing S3-compatible service.
STORAGE_MODE=
# Storage URL reachable from browsers; must be HTTPS when the origin is HTTPS.
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=
# Storage URL reachable from containers. Written by `qjudge addon storage init` in bundled mode.
OBJECT_STORAGE_ENDPOINT_URL=
# Storage access key. Written by `qjudge addon storage init` in bundled mode.
OBJECT_STORAGE_ACCESS_KEY=
# Storage secret key. Written by `qjudge addon storage init` in bundled mode.
OBJECT_STORAGE_SECRET_KEY=
# Bucket name. Written by `qjudge addon storage init` in bundled mode.
OBJECT_STORAGE_BUCKET=

# --- Live monitoring (LiveKit) ---
# disabled, bundled (LiveKit addon) or external (existing LiveKit).
# MEDIA_MODE=
# LiveKit URL browsers connect to, e.g. wss://live.example.edu.
# LIVEKIT_PUBLIC_URL=
# LiveKit API key.
# LIVEKIT_API_KEY=
# LiveKit API secret.
# LIVEKIT_API_SECRET=
# Public IP LiveKit advertises for media (bundled mode).
# LIVEKIT_NODE_IP=
# DNS-only TURN hostname (bundled mode).
# LIVEKIT_TURN_HOST=
# TURN shared secret (bundled mode).
# LIVEKIT_TURN_SECRET=

# --- AI providers ---
# OpenAI API key.
# OPENAI_API_KEY=
# OpenAI-compatible base URL override.
# OPENAI_BASE_URL=
# DeepSeek API key.
# DEEPSEEK_API_KEY=
# DeepSeek base URL override.
# DEEPSEEK_BASE_URL=
# Self-hosted vLLM API key.
# VLLM_API_KEY=
# Self-hosted vLLM OpenAI-compatible URL.
# VLLM_BASE_URL=

# --- Third-party login ---
# Nycu OAuth client ID.
# NYCU_OAUTH_CLIENT_ID=
# Nycu OAuth client secret.
# NYCU_OAUTH_CLIENT_SECRET=
# Github OAuth client ID.
# GITHUB_OAUTH_CLIENT_ID=
# Github OAuth client secret.
# GITHUB_OAUTH_CLIENT_SECRET=
# Google OAuth client ID.
# GOOGLE_OAUTH_CLIENT_ID=
# Google OAuth client secret.
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- Email ---
# SMTP username.
# EMAIL_HOST_USER=
# SMTP password.
# EMAIL_HOST_PASSWORD=

# --- Remote MCP ---
# true exposes /mcp for external MCP clients.
# QJUDGE_REMOTE_MCP_ENABLED=

# --- Cloudflare Tunnel ---
# Cloudflare Tunnel token; required when COMPOSE_PROFILES includes tunnel.
# TUNNEL_TOKEN=
