# syntax=docker/dockerfile:1
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# BuildKit: cache downloaded .deb between builds; --no-install-recommends avoids extra packages
RUN --mount=type=cache,target=/var/cache/apt/archives,sharing=locked \
    for i in 1 2 3; do apt-get update && break || sleep 10; done \
    && apt-get install -y --no-install-recommends \
    g++ \
    gcc \
    time \
    python3 \
    openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# Precompiled bits/stdc++.h. g++ only uses it with the same flags, so these
# must match the C++ compile command in backend/apps/judge/io_judge.py.
RUN header="/usr/include/$(gcc -dumpmachine)/c++/$(gcc -dumpversion)/bits/stdc++.h" \
    && g++ -O2 -std=c++20 -x c++-header "$header" -o "$header.gch"

WORKDIR /judge

RUN useradd -m -u 1001 judge && \
    chown -R judge:judge /judge

USER judge
