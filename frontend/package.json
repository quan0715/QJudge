{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:i18n": "node scripts/check-i18n-sync.js",
    "check:typography": "node scripts/check-typography-tokens.js",
    "sync:i18n": "node scripts/sync-i18n.js",
    "lint": "eslint . --max-warnings=289",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workbench-browser": "playwright test -c playwright.config.workbench.ts",
    "screenshot:exam-states": "node scripts/exam-shell-states.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck:copilot": "tsc -p tsconfig.copilot-type-tests.json",
    "check:copilot-boundary": "node scripts/check-copilot-package-boundary.js",
    "check:copilot-dogfood": "node scripts/check-copilot-dogfood-boundary.js",
    "test:copilot": "vitest run src/core/copilot src/shared/copilot src/infrastructure/copilot src/features/chatbot/adapters src/features/chatbot/contexts/QJudgeCopilotProvider.test.tsx src/features/chatbot/components/chat-ui/QJudgeChatPanel.test.tsx",
    "build:copilot-example": "vite build --config vite.config.copilot-example.ts",
    "test:api": "vitest run --config vitest.config.api.ts",
    "test:api:watch": "vitest --config vitest.config.api.ts",
    "test:e2e": "playwright test -c playwright.config.e2e.ts",
    "test:e2e:auth": "playwright test -c playwright.config.e2e.ts tests/e2e/auth.e2e.spec.ts",
    "test:e2e:ui": "playwright test -c playwright.config.e2e.ts --ui --ui-host localhost",
    "test:e2e:debug": "playwright test -c playwright.config.e2e.ts --debug",
    "test:e2e:headed": "playwright test -c playwright.config.e2e.ts --headed",
    "test:e2e:report": "playwright show-report playwright-report-e2e",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@carbon/charts": "^1.27.27",
    "@carbon/charts-react": "^1.27.27",
    "@carbon/icons-react": "^11.92.0",
    "@carbon/react": "^1.120.0",
    "@hookform/resolvers": "7.0.6",
    "@lobehub/icons": "^6.15.2",
    "@monaco-editor/react": "^4.7.0",
    "@popcornt/mimi": "0.1.1",
    "@rc-component/qrcode": "~2.0.0",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "driver.js": "1.14.0",
    "github-slugger": "^2.0.0",
    "i18next": "^27.1.1",
    "jsqr": "1.4.0",
    "katex": "^0.19.1",
    "livekit-client": "2.24.1",
    "mathlive": "^0.111.4",
    "mermaid": "^12.3.0",
    "motion": "14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.23.0",
    "react-router-dom": "7.18.5",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.108.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/github-slugger": "^2.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "10.6.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "monaco-editor": "^0.57.0",
    "storybook": "10.6.7",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "react-router": "7.18.2",
    "dompurify": "3.4.17",
    "immutable": "5.1.8",
    "lodash-es": "^4.17.23"
  }
}
