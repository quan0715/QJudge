{
  "version": 1,
  "decisions": [
    {
      "id": "composite-navigation-controls",
      "rules": ["raw-interactive-control"],
      "components": ["button"],
      "paths": [
        "features/ai-tasks/shell/InitPromptEditor.tsx",
        "features/ai-tasks/shell/TaskDetailPanel.tsx",
        "features/ai-tasks/shell/TaskMainTabs.tsx",
        "features/app/components/SideMenu.tsx",
        "features/app/components/SideMenuContestRuntimeSection.tsx",
        "features/app/components/SideMenuToggle.tsx",
        "features/app/components/UserMenu.tsx",
        "features/app/components/workspace/WorkspaceTopNav.tsx",
        "features/chatbot/components/chat-ui/ChatHistoryPanel.tsx",
        "features/chatbot/components/chat-ui/ChatTopBar.tsx",
        "features/chatbot/components/chat-ui/ComposerBar.tsx",
        "features/chatbot/components/chat-ui/QJudgeCopilotSlotComponents.tsx",
        "features/chatbot/components/chat-ui/SessionBadges.tsx",
        "features/chatbot/components/workspace/WorkspaceShell.tsx",
        "features/contest/components/exam/ExamNavigator.tsx",
        "features/contest/components/exam/ExamQuestionCard.tsx",
        "features/contest/components/exam/PaperExamCore.tsx",
        "features/contest/screens/settings/grading/GradingByStudentTabScreen.tsx",
        "features/contest/screens/settings/grading/GradingMatrixViewScreen.tsx",
        "features/contest/screens/settings/grading/GradingMobileNav.tsx",
        "features/contest/screens/settings/grading/GradingSplitPanelScreen.tsx",
        "features/contest/screens/settings/grading/QuestionSidebarScreen.tsx",
        "features/docs/components/DocSidebar.tsx",
        "features/docs/components/DocsSearchDropdown.tsx",
        "shared/ai/ModelSelect.tsx",
        "shared/components/scrollSpy/ScrollSpyNav.tsx",
        "shared/ui/list/ListPanel.tsx",
        "shared/ui/navigation/TextModeSwitcher.tsx",
        "shared/ui/solver/editor/LanguageSelector.tsx"
      ],
      "reason": "These buttons implement composite navigation, disclosure, menu, tab, or listbox semantics with app-owned focus and selection behavior; Carbon Button is not the owning pattern.",
      "owner": "frontend-ui",
      "removalCondition": "Replace a control only when its whole composite migrates to the equivalent Carbon navigation, tabs, accordion, menu, or listbox component."
    },
    {
      "id": "rich-selection-surface-controls",
      "rules": ["raw-interactive-control"],
      "components": ["button"],
      "paths": [
        "features/auth/screens/CampusSsoScreen.tsx",
        "features/chatbot/components/artifact/ArtifactInlineCard.tsx",
        "features/classroom/components/ClassroomMonthSchedule.tsx",
        "features/classroom/components/ClassroomSettingsGeneralPanel.tsx",
        "features/classroom/components/CreateContestModal.tsx",
        "features/classroom/screens/panels/ContestPanel.tsx",
        "features/contest/components/admin/AdminOverviewCommandCenter.tsx",
        "features/contest/components/admin/EventIncidentCard.tsx",
        "features/contest/components/admin/examEditor/CodingProblemPreviewCard.tsx",
        "features/contest/components/admin/examEditor/CodingProblemTabbedEditor.tsx",
        "features/contest/components/admin/examEditor/ExamEditorLayout.tsx",
        "features/contest/components/admin/examEditor/ExamGroupEditCard.tsx",
        "features/contest/components/admin/examEditor/ExamQuestionEditCard.tsx",
        "features/contest/components/admin/statistics/AdminQuestionStatsGallery.tsx",
        "features/contest/components/admin/statistics/ContestResultDashboardPanel.tsx",
        "features/contest/screens/admin/attendance/AttendanceProjectionScreen.tsx",
        "features/contest/screens/admin/panels/AdminProctoringPanel.tsx",
        "features/contest/screens/attendance/components/ShutterRow.tsx",
        "features/dashboard/screens/DashboardScreen.tsx",
        "features/question-banks/components/QuestionBankProblemManagementPanel.tsx",
        "features/question-banks/components/QuestionBankSettingsGeneralPanel.tsx",
        "shared/ui/dataCard/ActionWidgetCard.tsx",
        "shared/ui/discussion/ProblemDiscussionThread.tsx",
        "shared/ui/scheduleCard/ScheduleCard.tsx"
      ],
      "reason": "These are semantic native buttons whose full visual surface is the selection target and whose nested layout is owned by the feature; they retain native keyboard and form safety semantics.",
      "owner": "frontend-ui",
      "removalCondition": "Migrate when the surface can use ClickableTile or another Carbon selection primitive without nested-interaction or layout regressions."
    },
    {
      "id": "landing-disclosure-controls",
      "rules": ["raw-interactive-control"],
      "components": ["button"],
      "paths": ["features/landing/sections/FaqSection.tsx"],
      "reason": "The FAQ question is a native disclosure trigger with aria-expanded and aria-controls; Carbon Button would not add disclosure semantics.",
      "owner": "frontend-ui",
      "removalCondition": "Replace only if the landing FAQ adopts Carbon Accordion without losing the branded presentation."
    },
    {
      "id": "editor-media-controls",
      "rules": ["raw-interactive-control"],
      "components": ["button"],
      "paths": [
        "shared/ui/editor/mathMarkdownEditor/MathMarkdownEditor.tsx",
        "shared/ui/editor/openAnswerDocument/FormulaEditorModal.tsx",
        "shared/ui/image/ImageEditDialog.tsx",
        "shared/ui/image/ImageViewer.tsx"
      ],
      "reason": "Editor and media surfaces require tightly coupled pointer, keyboard, geometry, and focus behavior; native controls are part of the app-owned editor boundary.",
      "owner": "frontend-ui",
      "removalCondition": "Replace only when the editor or media surface adopts an equivalent Carbon-supported control without changing manipulation behavior."
    },
    {
      "id": "platform-native-data-controls",
      "rules": ["raw-interactive-control"],
      "components": ["input", "textarea"],
      "paths": [
        "features/chatbot/components/chat-ui/ChatHistoryPanel.tsx",
        "features/chatbot/components/chat-ui/ChatTopBar.tsx",
        "features/chatbot/components/chat-ui/ComposerBar.tsx",
        "features/classroom/components/AddMembersModal.tsx",
        "features/contest/screens/attendance/components/ManualCodeContent.tsx",
        "features/contest/screens/settings/ContestLogsScreen.tsx",
        "features/landing/components/LandingMiniJudgeSection.tsx",
        "features/question-banks/components/ImportInboxModal.tsx",
        "shared/ui/image/ImageEditDialog.tsx",
        "shared/ui/markdown/markdownEditor/MarkdownEditor.tsx"
      ],
      "reason": "These controls depend on browser file-picking, OTP, autosizing composer, inline rename, code-editing, or decorative-selection behavior that Carbon form wrappers do not own.",
      "owner": "frontend-ui",
      "removalCondition": "Migrate individual text controls when their specialized behavior is removed; hidden file inputs remain native platform boundaries."
    },
    {
      "id": "contextual-inline-notifications",
      "rules": ["notification-variant-review"],
      "components": ["InlineNotification"],
      "paths": [
        "features/admin/screens/UserManagementScreen.tsx",
        "features/app/components/ErrorBoundary.tsx",
        "features/auth/components/settings/MCPSetupPanel.tsx",
        "features/auth/pending-actions/PendingActionBanner.tsx",
        "features/auth/screens/InviteLinkScreen.tsx",
        "features/auth/screens/OAuthAuthorizeScreen.tsx",
        "features/auth/screens/OnboardingScreen.tsx",
        "features/chatbot/components/chat-ui/HITLCard.tsx",
        "features/chatbot/components/chat-ui/QJudgeCopilotSlotComponents.tsx",
        "features/chatbot/components/chat-ui/QuestionCard.tsx",
        "features/classroom/components/AddMembersModal.tsx",
        "features/classroom/components/CreateContestModal.tsx",
        "features/contest/components/ContestOverview.tsx",
        "features/contest/components/exam/PaperExamResultsList.tsx",
        "features/contest/components/modals/ContestRegistrationModal.tsx",
        "features/contest/components/participants/ParticipantDashboardPane.tsx",
        "features/contest/components/participants/ParticipantOperationsPane.tsx",
        "features/contest/components/solver/submissions/ContestProblemSubmissions.tsx",
        "features/contest/components/studentDashboard/StudentContestDashboardView.tsx",
        "features/contest/screens/admin/attendance/AttendanceProjectionScreen.tsx",
        "features/contest/screens/attendance/components/ConfirmContent.tsx",
        "features/contest/screens/attendance/components/ManualCodeContent.tsx",
        "features/contest/screens/attendance/components/PhotoContent.tsx",
        "features/contest/screens/attendance/components/ScanContent.tsx",
        "features/contest/screens/paperExam/ExamPrecheckScreen.tsx",
        "features/contest/screens/paperExam/PaperExamAnsweringScreen.tsx",
        "features/contest/screens/settings/grading/components/RedistributeTargetModal.tsx",
        "features/docs/components/DocFeedback.tsx",
        "features/problems/components/edit/problemForm/sections/BasicInfoSection.tsx",
        "features/problems/components/solve/editorview/ProblemFullPageSolve.tsx",
        "shared/ui/submission/TestResultDetail.tsx"
      ],
      "reason": "Each notification reports state tied to the surrounding task, form, modal, or data panel and therefore follows Carbon inline-notification lifecycle guidance.",
      "owner": "frontend-ui",
      "removalCondition": "Use a toast only if the message becomes transient and global; use ActionableNotification only when recovery is performed inside the notification."
    },
    {
      "id": "global-toast-host",
      "rules": ["notification-variant-review"],
      "components": ["ToastNotification"],
      "paths": ["shared/contexts/ToastContext.tsx"],
      "reason": "The shared toast host is the single transient global-feedback channel used by useToast.",
      "owner": "frontend-ui",
      "removalCondition": "Replace only if the application adopts a different single global notification host."
    }
  ]
}
